# ─── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
build/
dist/
.installed.cfg
pip-wheel-metadata/

# Virtualenvs
.venv/
venv/
env/
ENV/

# ─── Poetry ──────────────────────────────────────────────────────────────
poetry.lock
# ^ Decisión: lock-file NO se commitea para el server hasta que CI esté
#   estabilizada. Cuando exista CI, revertir esta línea (sí commitear lock).

# ─── Pytest / Coverage / Mypy / Ruff ─────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.cache/
.mypy_cache/
.ruff_cache/

# ─── Env / Secrets ───────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Claude Code (config local por-usuario) ──────────────────────────────
.claude/settings.local.json
# ^ Permisos personales de la instancia; CLAUDE.md sí se puede commitear.

# ─── Versioning ──────────────────────────────────────────────────────────
src/yvy_server/_version.py
# ^ Generado por scripts/embed_version.py en build time. Nunca se commitea.

# ─── Docker ──────────────────────────────────────────────────────────────
.docker/
docker-compose.override.yml

# ─── IDE ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ─── Logs / runtime ──────────────────────────────────────────────────────
*.log
logs/

# ─── Dumps de base de datos (contienen credenciales y datos reales) ─────
*.sql.gz
*.dump
# Dump plano de producción usado en el ensayo de M0
docs/yvy_*.sql
