# YVY Server · Variables de entorno
# ===================================================================
# Copiar este archivo a `.env` (NO commitear .env) y rellenar valores.
# Las variables usan prefijo YVY_ para evitar colisión con otras apps.
# ===================================================================

# ─── Aplicación ───────────────────────────────────────────────────
# Entorno: local | staging | production
YVY_ENV=local

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
YVY_LOG_LEVEL=INFO

# Schema versions que el server acepta (CSV).
# En 9.1 solo "1.0". Cuando llegue 1.1, agregar acá sin migración.
YVY_SUPPORTED_SCHEMAS=1.0

# Skew temporal máximo permitido en segundos. Default: 1800 (30 min).
YVY_CLOCK_SKEW_MAX_SECONDS=1800

# Skew temporal de warning (X-Clock-Warning header). Default: 300 (5 min).
YVY_CLOCK_SKEW_WARN_SECONDS=300

# ─── Base de datos ────────────────────────────────────────────────
# DSN async para SQLAlchemy + asyncpg.
# Ejemplo local: postgresql+asyncpg://yvy:yvy@localhost:5432/yvy
# Ejemplo docker-compose (network interna): postgresql+asyncpg://yvy:yvy@postgres:5432/yvy
YVY_DB_DSN=postgresql+asyncpg://yvy:yvy@localhost:5432/yvy

# Tamaño del pool de conexiones
YVY_DB_POOL_SIZE=10
YVY_DB_MAX_OVERFLOW=5

# ─── Auth admin (Bearer token) ────────────────────────────────────
# Token único para endpoints /api/v1/admin/*.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
YVY_ADMIN_TOKEN=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_48

# ─── HTTP ─────────────────────────────────────────────────────────
YVY_HOST=0.0.0.0
YVY_PORT=8000

# ─── Postgres (para docker-compose) ───────────────────────────────
# Estas las consume el servicio postgres en docker-compose.yml,
# NO la aplicación directamente (la app usa YVY_DB_DSN).
POSTGRES_DB=yvy
POSTGRES_USER=yvy
POSTGRES_PASSWORD=yvy
